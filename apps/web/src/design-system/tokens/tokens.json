  "policies": {
    "contrast": [
      {
        "foreground": "semantic.color.text.primary",
        "background": "semantic.color.surface.page",
        "minimum": 4.5,
        "usage": "Default body text"
      },
      {
        "foreground": "semantic.color.text.secondary",
        "background": "semantic.color.surface.raised",
        "minimum": 4.5,
        "usage": "Supporting text"
      },
      {
        "foreground": "semantic.color.text.accent",
        "background": "semantic.color.surface.raised",
        "minimum": 4.5,
        "usage": "Accent text"
      },
      {
        "foreground": "semantic.color.text.error",
        "background": "semantic.color.surface.raised",
        "minimum": 4.5,
        "usage": "Error text"
      }
    ],
    "motion": {
      "levels": {
        "0": "stable",
        "1": "functional",
        "2": "composed",
        "3": "cinematic",
        "4": "immersive-opt-in"
      },
      "protectedContexts": {
        "emergency": 0,
        "urgent-guidance": 0,
        "appointment-consequence": 0,
        "error": 0,
        "privacy-consent": 0,
        "unavailable-expired": 0,
        "unknown-outcome": 0
      },
      "reducedEquivalents": {
        "semantic.motion.functional.duration": "semantic.motion.static.duration",
        "semantic.motion.functional.distance": "semantic.motion.static.distance",
        "semantic.motion.functional.easing": "semantic.motion.static.easing",
        "semantic.motion.composed.duration": "semantic.motion.static.duration",
        "semantic.motion.composed.distance": "semantic.motion.static.distance",
        "semantic.motion.composed.easing": "semantic.motion.static.easing",
        "semantic.motion.cinematic.duration": "semantic.motion.static.duration",
        "semantic.motion.cinematic.distance": "semantic.motion.static.distance",
        "semantic.motion.cinematic.easing": "semantic.motion.static.easing",
        "semantic.motion.immersive.duration": "semantic.motion.static.duration",
        "semantic.motion.immersive.easing": "semantic.motion.static.easing"
      }
