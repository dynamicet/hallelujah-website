    "system-states:check": "node scripts/check-system-states.mjs",
    "test": "pnpm partners:check && pnpm patient-guide:check && pnpm health-finder:check && pnpm care-journeys:check && pnpm care-selection:check && pnpm patient-testimonials:check && pnpm tokens:check && pnpm foundations:check && pnpm home:check && pnpm home-enhancement:check && pnpm home-contacts:check && pnpm home-governed:check && pnpm emergency:check && pnpm actions:check && pnpm appointment:check && pnpm appointment-page:check && pnpm clinician-directory:check && pnpm clinician-directory:validate && pnpm clinician-profile:check && pnpm clinician-profile:validate && pnpm service-directory:check && pnpm service-directory:validate && pnpm shell:check && pnpm search-controls:check && pnpm form-primitives:check && pnpm system-states:check && pnpm optional-map:check && pnpm governed-records:check && pnpm content-transfer:check && pnpm cms-workflow:check && pnpm site-settings:check && pnpm clinicians:check && pnpm services:check && pnpm care-relationships:check && pnpm visitor-topics:check && pnpm institutional-blocks:check && pnpm utility-statements:check && pnpm discovery:check && pnpm content-integrity:check && pnpm assets:check && pnpm assets:formats:check && node scripts/check-boundaries.mjs && node scripts/check-environment.mjs",
