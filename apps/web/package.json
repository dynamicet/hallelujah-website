    "appointment:db-local": "node scripts/run-appointment-db.mjs",
    "appointment-page:check": "node scripts/check-appointment-page.mjs",
    "appointment-page:preview": "node scripts/serve-appointment-page-preview.mjs",
    "appointment-page:smoke": "node scripts/check-appointment-page-rendered.mjs",
