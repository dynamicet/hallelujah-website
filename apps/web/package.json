{
  "name": "@hallelujah/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.27.0"
  },
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "config:check": "node --env-file-if-exists=.env.local scripts/check-runtime-environment.mjs",
    "dev": "pnpm config:check && NEXT_TELEMETRY_DISABLED=1 next dev",
    "foundations:check": "node scripts/check-foundations.mjs",
    "lint": "eslint . --max-warnings=0",
    "start": "pnpm config:check && NEXT_TELEMETRY_DISABLED=1 next start",
    "test": "pnpm tokens:check && pnpm foundations:check && node scripts/check-boundaries.mjs && node scripts/check-environment.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "graphql": "16.11.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3"
  }
}
