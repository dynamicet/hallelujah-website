{
  "name": "@hallelujah/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.27.0"
  },
  "scripts": {
    "actions:check": "node scripts/check-essential-actions.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "config:check": "node --env-file-if-exists=.env.local scripts/check-runtime-environment.mjs",
    "dev": "pnpm config:check && NEXT_TELEMETRY_DISABLED=1 next dev",
    "foundations:check": "node scripts/check-foundations.mjs",
    "home:check": "node scripts/check-home.mjs",
    "home:preview": "node scripts/serve-home-preview.mjs",
    "home:smoke": "node scripts/check-home-rendered.mjs",
    "home-contacts:check": "node scripts/check-home-contacts.mjs",
    "home-contacts:smoke": "node scripts/check-home-rendered.mjs --contacts",
    "form-primitives:check": "node scripts/check-form-primitives.mjs",
    "governed-records:check": "node scripts/check-governed-records.mjs",
    "governed-records:db-smoke": "node scripts/check-governed-cms-db.mjs",
    "local-db-isolation:check": "node scripts/check-local-db-isolation.mjs",
    "optional-map:check": "node scripts/check-optional-map.mjs",
    "search-controls:check": "node scripts/check-search-controls.mjs",
    "shell:check": "node scripts/check-global-shell.mjs",
    "lint": "eslint . --max-warnings=0",
    "start": "pnpm config:check && NEXT_TELEMETRY_DISABLED=1 next start",
    "system-states:check": "node scripts/check-system-states.mjs",
    "test": "pnpm tokens:check && pnpm foundations:check && pnpm home:check && pnpm home-contacts:check && pnpm actions:check && pnpm shell:check && pnpm search-controls:check && pnpm form-primitives:check && pnpm system-states:check && pnpm optional-map:check && pnpm governed-records:check && pnpm content-transfer:check && pnpm cms-workflow:check && pnpm site-settings:check && pnpm clinicians:check && pnpm services:check && pnpm care-relationships:check && pnpm visitor-topics:check && pnpm institutional-blocks:check && pnpm utility-statements:check && pnpm discovery:check && pnpm content-integrity:check && pnpm assets:check && pnpm assets:formats:check && node scripts/check-boundaries.mjs && node scripts/check-environment.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "cms-workflow:check": "node scripts/check-cms-workflow.mjs",
    "site-settings:check": "node scripts/check-site-settings.mjs",
    "clinicians:check": "node scripts/check-clinicians.mjs",
    "services:check": "node scripts/check-services.mjs",
    "care-relationships:check": "node scripts/check-care-relationships.mjs",
    "visitor-topics:check": "node scripts/check-visitor-topics.mjs",
    "institutional-blocks:check": "node scripts/check-institutional-blocks.mjs",
    "utility-statements:check": "node scripts/check-utility-statements.mjs",
    "utility-statements:smoke": "node scripts/check-utility-statements-rendered.mjs",
    "discovery:check": "node scripts/check-governed-discovery.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:db-smoke": "node scripts/check-governed-cms-db.mjs --assets-only",
    "assets:formats:check": "node scripts/check-assets-formats.mjs",
    "assets:malware:check": "node scripts/check-assets-malware.mjs",
    "assets:smoke": "node scripts/check-assets-rendered.mjs",
    "content-transfer:check": "node scripts/check-content-transfer.mjs",
    "content-transfer:db-smoke": "node scripts/check-governed-cms-db.mjs --transfer-only",
    "content-transfer": "node --env-file-if-exists=.env.local scripts/content-transfer.mjs",
    "content-integrity:check": "node scripts/check-content-integrity.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "graphql": "16.11.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3"
  }
}
