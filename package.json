{
  "name": "hallelujah-hospital-website",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.27.0"
  },
  "scripts": {
    "accessibility:smoke": "node scripts/check-built-accessibility.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "backlog:check": "node docs/backlog/audit-backlog.mjs",
    "build": "pnpm --dir apps/web build",
    "budgets:smoke": "node scripts/check-built-budgets.mjs",
    "ci:policy": "node scripts/check-ci-policy.mjs",
    "ci:controls:test": "node scripts/test-ci-controls.mjs",
    "dev": "pnpm --dir apps/web dev",
    "format:check": "node scripts/check-format.mjs",
    "introduction:check": "node scripts/check-introduction-gates.mjs",
    "lint": "node apps/web/node_modules/eslint/bin/eslint.js apps/web scripts docs/backlog/audit-backlog.mjs eslint.config.mjs --max-warnings=0",
    "links:check": "node scripts/check-local-links.mjs",
    "rebuild:verify": "node scripts/verify-clean-rebuild.mjs",
    "runtime:smoke": "node scripts/check-runtime-smoke.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "start": "pnpm --dir apps/web start",
    "test": "pnpm --dir apps/web test",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "toolchain:check:containers": "node scripts/check-toolchain.mjs --include-container-tools",
    "tokens:check": "pnpm --dir apps/web tokens:check",
    "tokens:generate": "pnpm --dir apps/web tokens:generate",
    "typecheck": "pnpm --dir apps/web typecheck",
    "verify": "pnpm toolchain:check && pnpm format:check && pnpm ci:policy && pnpm ci:controls:test && pnpm links:check && pnpm secrets:check && pnpm backlog:check && pnpm introduction:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm accessibility:smoke && pnpm budgets:smoke && pnpm runtime:smoke"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "dompurify": "3.4.15"
    }
  }
}
