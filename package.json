{
  "name": "hallelujah-hospital-website",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.27.0"
  },
  "scripts": {
    "actions:check": "pnpm --dir apps/web actions:check",
    "actions:smoke": "node scripts/check-rendered-foundations.mjs --capture-prefix b01-005-essential-actions",
    "accessibility:smoke": "node scripts/check-built-accessibility.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "backlog:check": "node docs/backlog/audit-backlog.mjs",
    "brand:check": "node scripts/check-brand-foundation.mjs",
    "build": "pnpm --dir apps/web build",
    "budgets:smoke": "node scripts/check-built-budgets.mjs",
    "ci:policy": "node scripts/check-ci-policy.mjs",
    "ci:controls:test": "node scripts/test-ci-controls.mjs",
    "dev": "pnpm --dir apps/web dev",
    "format:check": "node scripts/check-format.mjs",
    "foundations:check": "pnpm --dir apps/web foundations:check",
    "form-primitives:check": "pnpm --dir apps/web form-primitives:check",
    "form-primitives:smoke": "node scripts/check-rendered-foundations.mjs --shell --search-controls --form-primitives --capture-prefix b01-009-form-primitives",
    "governed-records:check": "pnpm --dir apps/web governed-records:check",
    "local-db-isolation:check": "pnpm --dir apps/web local-db-isolation:check",
    "foundations:smoke": "node scripts/check-rendered-foundations.mjs",
    "introduction:check": "node scripts/check-introduction-gates.mjs",
    "lint": "node apps/web/node_modules/eslint/bin/eslint.js apps/web scripts docs/backlog/audit-backlog.mjs eslint.config.mjs --max-warnings=0",
    "motion-media:smoke": "node scripts/check-rendered-foundations.mjs --motion-media --capture-prefix b01-012-motion-media",
    "links:check": "node scripts/check-local-links.mjs",
    "rebuild:verify": "node scripts/verify-clean-rebuild.mjs",
    "runtime:smoke": "node scripts/check-runtime-smoke.mjs",
    "search-controls:check": "pnpm --dir apps/web search-controls:check",
    "search-controls:smoke": "node scripts/check-rendered-foundations.mjs --shell --search-controls --capture-prefix b01-007-search-controls",
    "shell:check": "pnpm --dir apps/web shell:check",
    "shell:smoke": "node scripts/check-rendered-foundations.mjs --shell --capture-prefix b01-006-global-shell",
    "system-states:check": "pnpm --dir apps/web system-states:check",
    "system-states:smoke": "node scripts/check-rendered-foundations.mjs --shell --search-controls --form-primitives --system-states --capture-prefix b01-010-system-states",
    "secrets:check": "node scripts/check-secrets.mjs",
    "start": "pnpm --dir apps/web start",
    "test": "pnpm --dir apps/web test",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "toolchain:check:containers": "node scripts/check-toolchain.mjs --include-container-tools",
    "tokens:check": "pnpm --dir apps/web tokens:check",
    "tokens:generate": "pnpm --dir apps/web tokens:generate",
    "typecheck": "pnpm --dir apps/web typecheck",
    "verify": "pnpm toolchain:check && pnpm format:check && pnpm ci:policy && pnpm ci:controls:test && pnpm links:check && pnpm secrets:check && pnpm backlog:check && pnpm brand:check && pnpm introduction:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm accessibility:smoke && pnpm budgets:smoke && pnpm runtime:smoke && pnpm foundations:smoke"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "dompurify": "3.4.15"
    }
  }
}
